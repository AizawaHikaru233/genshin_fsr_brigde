#pragma code_page(65001)

#include <windows.h>
// 版本号来自 CMake 生成的头（单一事实源 = CMakeLists 的 project(... VERSION ...)）。
// 2026-09-19 审核报告：此前 FILEVERSION / FileVersion 等为**手写**，改版本需多处同步。
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FUFU_VERSION_COMMA
 PRODUCTVERSION FUFU_VERSION_COMMA
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Celia"
            VALUE "FileDescription", "Genshin FSR2 Bridge Plugin for FufuLauncher"
            VALUE "FileVersion", FUFU_VERSION_DOTTED
            VALUE "InternalName", "FSR-Bridge-Plugin"
            VALUE "LegalCopyright", "Copyright (C) 2026 Celia"
            VALUE "OriginalFilename", "FSR-Bridge-Plugin.dll"
            VALUE "ProductName", "Genshin FSR2 Bridge Plugin"
            VALUE "ProductVersion", FUFU_VERSION_DOTTED
            VALUE "Comments", "Loads Bridge, OptiScaler and ReShade from the Fufu plugin directory."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
