#pragma code_page(65001)

#include <windows.h>
// 版本号来自 CMake 生成的头（单一事实源 = CMakeLists 的 project(... VERSION ...)）。
// 2026-09-19 审核报告：此前 FILEVERSION / FileVersion 等为**手写**，改版本需多处同步。
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ANTIPLAYER_VERSION_COMMA
 PRODUCTVERSION ANTIPLAYER_VERSION_COMMA
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Celia"
            VALUE "FileDescription", "Genshin Impact Anti-Blur and Player Mosaic Control"
            VALUE "FileVersion", ANTIPLAYER_VERSION_DOTTED
            VALUE "InternalName", "AntiPlayerMosaic"
            VALUE "LegalCopyright", "Copyright (C) 2026 Celia"
            VALUE "OriginalFilename", "AntiPlayerMosaic.dll"
            VALUE "ProductName", "Genshin Impact Visual Fixes"
            VALUE "ProductVersion", ANTIPLAYER_VERSION_DOTTED
            VALUE "Comments", "Runtime anti-blur and player mosaic control module."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
