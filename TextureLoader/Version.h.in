#define TEXTURELOADER_VERSION_DOTTED \
    TEXTURELOADER_STR(TEXTURELOADER_VERSION_MAJOR) "." \
    TEXTURELOADER_STR(TEXTURELOADER_VERSION_MINOR) "." \
    TEXTURELOADER_STR(TEXTURELOADER_VERSION_PATCH) "." \
    TEXTURELOADER_STR(TEXTURELOADER_VERSION_TWEAK)
