// 与 Dx11FsrBridge / FufuGraphicsPlugin / AntiPlayerMosaic 使用同一套机制。
#pragma once

#define TEXTURELOADER_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define TEXTURELOADER_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define TEXTURELOADER_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define TEXTURELOADER_VERSION_TWEAK @PROJECT_VERSION_TWEAK@

// 逗号分隔（供 VERSIONINFO 的 FILEVERSION / PRODUCTVERSION）
#define TEXTURELOADER_VERSION_COMMA \
    TEXTURELOADER_VERSION_MAJOR, TEXTURELOADER_VERSION_MINOR, \
    TEXTURELOADER_VERSION_PATCH, TEXTURELOADER_VERSION_TWEAK

// 点分字符串（供 VALUE "FileVersion" / "ProductVersion"）
#define TEXTURELOADER_STR2(x) #x
