{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genshin FSR Bridge",
  "version": "2.4.0",
  "identifier": "app.gfsr.installer",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Genshin FSR Bridge",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
